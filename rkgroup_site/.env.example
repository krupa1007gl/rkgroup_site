# Скопируйте этот файл в .env и заполните реальными значениями.
# .env никогда не коммитится (см. .gitignore).

# Django. Сгенерировать новый ключ:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# True только для локальной разработки, на проде всегда False
DEBUG=False

# Через запятую, без пробелов вокруг запятой не обязательно
ALLOWED_HOSTS=localhost,127.0.0.1

# Rate limiting на формах (обратный звонок, контакты, партнёрство,
# консультация, AI Lab). На проде должен быть True.
RATELIMIT_ENABLED=True
